--- Result type and constructors.
--- @details
--- The `result` package provides the `Result<T, E>` type and the `ok`
--- / `err` constructors over the canonical `__ctor__` object shape
--- (ADR-0152 §2 — the post-`__tag__` mint, phase-3 WS-F).
---
--- `ok(v)` mints `{"__ctor__": ok, value: v, type: Result}` — the same
--- record a `Result := new Inductive { ok : (value : a) ~> Result(e, a), err : (error : e) ~> Result(e, a) }` declaration
--- produces — so `match` dispatches on ctor-sym identity
--- (`match v { ok(x): …, err(e): … }`), never a `__tag__` string. The
--- mint stays manual rather than an inductive declaration because a
--- family record's constructors bind module scope but produce no
--- `export` record entry beyond the family name (the export transform
--- is text-level); once `export` projects constructor names this file
--- becomes `Result := new Inductive { … }`.

--- @template T - the success value type
--- @template E - the error value type
--- The `Result<T, E>` type.
--- @details
--- A `Result<T, E>` is either `Ok(value: T)` or `Err(error: E)`.
export Result<T, E> := (t, e) ~> type.Type()

--- Construct an Ok result wrapping a success value.
--- @param {value} - the success value of type T
--- @returns {Result<T, E>}
--- No `: T ~>[1] Result<T, E>` signature: `Result<T, E>` is a
--- former-app (`App(Result, T, E)`) while the minted record synthesizes
--- `type.record`, and the checker cannot unify the two — the same
--- reason lib-option dropped `some`'s signature (5de192c). The `<T,E>`
--- template and `~>[1]` grade rode the signature, so they drop with it
--- (a signature-less `~>[1]` impl exports as a non-arrow value); the
--- `Result<T, E>` contract is carried by the type decl + docs.
export ok := (value) ~> do {
  { "__ctor__": sym.seeded("data.Result.ok"),
    "value": value,
    "type": { "__former__": sym.seeded("data.Result"), "indices": [null, null] } }
}

--- Construct an Err result wrapping an error value.
--- @param {error} - the error value of type E
--- @returns {Result<T, E>}
--- Signature dropped for the same former-app/record unify reason as
--- `ok` (see above).
export err := (error) ~> do {
  { "__ctor__": sym.seeded("data.Result.err"),
    "value": error,
    "type": { "__former__": sym.seeded("data.Result"), "indices": [null, null] } }
}
