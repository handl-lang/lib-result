from "./index" import * as result

--- `result.ok(v)`/`result.err(e)` mint canonical `__ctor__` objects —
--- `match` dispatches on the ctor sym (phase-3 WS-F; no `__tag__`).
test_result_ok_tag := assert match result.ok(42) { ok(_): true, _: false }

test_result_ok_value := assert match result.ok(42) { ok(v): v, _: null } = 42

test_result_err_tag := assert match result.err("bad") { err(_): true, _: false }

test_result_err_value := assert match result.err("bad") { err(e): e, _: null } = "bad"
